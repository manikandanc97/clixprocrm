# ==============================================================================
# ClixProCRM API — Production Environment Configuration Template
# ==============================================================================

# Server Port (Optional, default: 4000)
PORT=4000
NODE_ENV=production

# ─── 1. Core Database Configuration (MANDATORY) ──────────────────────────────
# PostgreSQL connection string for Prisma ORM with SSL enabled
DATABASE_URL=postgresql://user:password@db.example.com:5432/clixprocrm?sslmode=require
DIRECT_URL=postgresql://user:password@db.example.com:5432/clixprocrm?sslmode=require

# ─── 2. Supabase Authentication & Client (MANDATORY) ─────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ─── 3. Field-Level Encryption Key (MANDATORY in Production) ─────────────────
# Must be exactly 64 hex characters (32 bytes AES-256-GCM master key).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── 4. Audit Log Cryptographic HMAC Secret (MANDATORY in Production) ────────
# High-entropy secret used for HMAC-SHA256 audit record sealing and hash chain integrity.
# Must be at least 32 characters long.
AUDIT_LOG_HMAC_SECRET=your_32_plus_char_high_entropy_audit_hmac_secret_here

# ─── 5. CORS & Allowed Origins (MANDATORY in Production) ─────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=https://app.clixprocrm.com,https://clixprocrm.vercel.app

# ─── 6. Upstash Distributed Redis (OPTIONAL / RECOMMENDED for Multi-Instance) ─
# Used for distributed rate limiting, new-device alert deduplication, and concurrent locking.
# If not configured, in-memory safe fallback is used.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ─── 6b. Redis TCP Connection for BullMQ Asynchronous Queues ─────────────────
# Connection URI for BullMQ queue infrastructure (supports redis:// and rediss:// for TLS).
# In production, this is required for BullMQ queues. In local dev, defaults to redis://127.0.0.1:6379 if omitted.
REDIS_URL=redis://localhost:6379

# ─── 7. SMTP Configuration for Security Alerts (OPTIONAL / RECOMMENDED) ──────
# Used for real-time security alerts (e.g. new-device detection, emergency state changes).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password
SMTP_FROM="ClixProCRM Security" <security-alerts@yourdomain.com>
SUPPORT_EMAIL=security-team@yourdomain.com

# ─── 8. AWS S3 WORM Immutable Audit Archive (OPTIONAL / ENTERPRISE) ──────────
# S3 Bucket configured with AWS Object Lock in COMPLIANCE mode for immutable WORM storage.
AWS_S3_AUDIT_BUCKET=clixprocrm-audit-worm-archive-prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── 9. Session Security Configuration (OPTIONAL, Defaults provided) ─────────
IDLE_SESSION_TIMEOUT_MINUTES=30
ABSOLUTE_SESSION_TIMEOUT_HOURS=24
SESSION_ACTIVITY_THROTTLE_SECONDS=60

# ─── 10. AI / External Integrations (OPTIONAL) ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
