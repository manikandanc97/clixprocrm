enum DealStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Company {
  id        String   @id @default(uuid())
  tenantId  String
  // AES-256-GCM encrypted PII fields
  name      String
  // HMAC-SHA256 lookup hash for encrypted name (exact-match search in lead create/convert)
  nameHash  String?
  industry  String?
  website   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  status    String   @default("ACTIVE")
  ownerId   String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User?           @relation(fields: [ownerId], references: [id])
  customers      Customer[]
  deals          Deal[]
  invoices       Invoice[]
  leads          Lead[]
  timelineEvents TimelineEvent[]
  teamId         String?
  branchId       String?

  @@index([tenantId])
  @@index([ownerId])
  @@index([tenantId, nameHash])
  @@index([tenantId, teamId])
}

model Deal {
  id                String    @id @default(uuid())
  tenantId          String
  name              String
  companyId         String?
  customerId        String?
  value             Decimal   @default(0) @db.Decimal(12, 2)
  stage             DealStage @default(NEW)
  probability       Int       @default(0)
  expectedCloseDate DateTime?
  ownerId           String?
  source            String    @default("Direct")
  description       String?
  status            String    @default("OPEN")
  lostReason        String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  leadId            String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  owner    User?     @relation("DealOwner", fields: [ownerId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])

  tasks          Task[]          @relation("TaskDeal")
  meetings       Meeting[]       @relation("MeetingDeal")
  quotations     Quotation[]     @relation("QuotationDeal")
  invoices       Invoice[]       @relation("InvoiceDeal")
  timelineEvents TimelineEvent[] @relation("TimelineDeal")
  teamId         String?
  branchId       String?

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, stage])
  @@index([tenantId, deletedAt, stage])
  @@index([tenantId, deletedAt, stage, updatedAt])
  @@index([tenantId, deletedAt, createdAt])
  @@index([tenantId, ownerId, deletedAt])
  @@index([companyId])
  @@index([customerId])
  @@index([ownerId])
  @@index([tenantId, teamId])
}

model InvoiceCounter {
