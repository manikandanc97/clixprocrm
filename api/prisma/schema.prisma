// ----------------------------------------------------
// Super Admin Platform SaaS Billing Models
// ----------------------------------------------------

model PlatformSubscription {
  id                 String            @id @default(uuid())
  tenantId           String
  planId             String
  billingCycle       String            @default("monthly") // monthly | annual
  seats              Int               @default(1)
  status             String            @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELLED, EXPIRED, SUSPENDED
  unitPrice          Decimal           @default(0) @db.Decimal(12, 2)
  recurringAmount    Decimal           @default(0) @db.Decimal(12, 2)
  currency           String            @default("INR")
  currentPeriodStart DateTime          @default(now())
  currentPeriodEnd   DateTime
  trialStart         DateTime?
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean           @default(false)
  cancelledAt        DateTime?
  
  // Payment Provider References
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPriceId        String?
  providerOrderId        String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices           PlatformInvoice[]

  @@index([tenantId])
  @@index([status])
  @@index([providerSubscriptionId])
  @@index([providerCustomerId])
}

model PlatformInvoice {
  id                 String                @id @default(uuid())
  tenantId           String
  subscriptionId     String?
  invoiceNumber      String                @unique // CP-INV-YYYY-XXXXXX
  planName           String
  billingCycle       String                @default("monthly")
  seats              Int                   @default(1)
  invoiceDate        DateTime              @default(now())
  dueDate            DateTime
  currency           String                @default("INR")
  subtotal           Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal               @default(0) @db.Decimal(12, 2)
  taxRate            Decimal               @default(18.0) @db.Decimal(6, 2)
  taxAmount          Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal               @default(0) @db.Decimal(12, 2)
  status             String                @default("PAID") // DRAFT, PENDING, PAID, OVERDUE, CANCELLED, REFUNDED, VOID
  paymentStatus      String                @default("PAID") // UNPAID, PROCESSING, PAID, FAILED, REFUNDED, PARTIALLY_REFUNDED
  pdfUrl             String?
  paidAt             DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription       PlatformSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items              PlatformInvoiceItem[]
  payments           PlatformPayment[]
  refunds            PlatformRefund[]

  @@index([tenantId])
  @@index([status])
  @@index([paymentStatus])
  @@index([invoiceDate])
}

model PlatformInvoiceItem {
  id                String          @id @default(uuid())
  platformInvoiceId String
  description       String
  quantity          Int             @default(1)
  unitPrice         Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal         @default(0) @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())

  platformInvoice   PlatformInvoice @relation(fields: [platformInvoiceId], references: [id], onDelete: Cascade)

  @@index([platformInvoiceId])
}

model PlatformPayment {
  id                   String           @id @default(uuid())
  platformInvoiceId    String
  tenantId             String
  paymentNumber        String           @unique // CP-PAY-YYYY-XXXXXX
  gatewayTransactionId String?
  gatewayProvider      String           @default("MANUAL") // MANUAL, RAZORPAY, STRIPE, BANK_WIRE
  amount               Decimal          @default(0) @db.Decimal(12, 2)
  currency             String           @default("INR")
  paymentMethod        String           @default("CARD") // CARD, UPI, NETBANKING, WIRE_TRANSFER, WALLET
  status               String           @default("SUCCESS") // PENDING, PROCESSING, SUCCESS, FAILED, REFUNDED
  paymentDate          DateTime         @default(now())
  notes                String?
  rawGatewayResponse   Json?
  
  // Provider References
  providerPaymentId    String?
  providerOrderId      String?
  providerSignature    String?

  createdAt            DateTime         @default(now())

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformInvoice      PlatformInvoice  @relation(fields: [platformInvoiceId], references: [id], onDelete: Cascade)
  refunds              PlatformRefund[]

  @@index([tenantId])
  @@index([platformInvoiceId])
  @@index([status])
  @@index([paymentDate])
  @@index([gatewayTransactionId])
  @@index([providerPaymentId])
}

model PlatformRefund {
  id                String          @id @default(uuid())
  platformInvoiceId String
  platformPaymentId String?
  tenantId          String
  refundNumber      String          @unique // CP-REF-YYYY-XXXXXX
  amount            Decimal         @default(0) @db.Decimal(12, 2)
  currency          String          @default("INR")
  reason            String
  status            String          @default("COMPLETED") // PENDING, COMPLETED, FAILED
  processedBy       String?
  createdAt         DateTime        @default(now())

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformInvoice   PlatformInvoice @relation(fields: [platformInvoiceId], references: [id], onDelete: Cascade)
  platformPayment   PlatformPayment? @relation(fields: [platformPaymentId], references: [id])

  @@index([tenantId])
  @@index([platformInvoiceId])
  @@index([platformPaymentId])
}

model PlatformBillingConfig {
  id                   String   @id @default("global")
  companyLegalName     String   @default("ClixPro Technologies Pvt. Ltd.")
  billingAddress       String?  @default("Level 4, Cyber City, Phase II")
  city                 String?  @default("Bengaluru")
  state                String?  @default("Karnataka")
  postalCode           String?  @default("560100")
  country              String?  @default("India")
  gstin                String?  @default("29AAAAA0000A1Z5")
  pan                  String?  @default("AAAAA0000A")
  invoicePrefix        String   @default("CP-INV")
  currency             String   @default("INR")
  taxRate              Decimal  @default(18.0) @db.Decimal(6, 2)
  paymentTermsDays     Int      @default(15)
  bankName             String?  @default("HDFC Bank")
  accountNumber        String?  @default("50200012345678")
  ifscCode             String?  @default("HDFC0001234")
  accountHolder        String?  @default("ClixPro Technologies Private Limited")
  upiId                String?  @default("clixpro@hdfcbank")
  paymentGateway       String   @default("RAZORPAY")
  webhookSecret        String?
  
  // API Keys (Stored safely server-side)
  razorpayKeyId        String?
  razorpayKeySecret    String?
  stripePublishableKey String?
  stripeSecretKey      String?

  updatedAt            DateTime @updatedAt
  updatedBy            String?
}

model PlatformWebhookEvent {
  id           String   @id @default(uuid())
  provider     String   // "RAZORPAY", "STRIPE", "MANUAL"
  eventId      String   @unique // Provider event / transaction reference for strict idempotency
  eventType    String
  payload      Json
  status       String   @default("PROCESSED") // "PROCESSED", "FAILED", "IGNORED"
  errorMessage String?
  processedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([provider, eventId])
  @@index([status])
  @@index([createdAt])
}

// ----------------------------------------------------
// Enterprise Support Desk Models
// ----------------------------------------------------

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id                    String                @id @default(uuid())
  ticketNumber          String                @unique // CP-SUP-2026-XXXXXX
  tenantId              String
  createdById           String
  assignedToId          String?
  subject               String
  category              String                @default("General")
  priority              SupportTicketPriority @default(MEDIUM)
  status                SupportTicketStatus   @default(OPEN)
  description           String
  diagnostics           Json?
  estimatedResponseTime String?
  resolvedAt            DateTime?
  closedAt              DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy             User                  @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo            User?                 @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  messages              SupportTicketMessage[]
  attachments           SupportTicketAttachment[]

  @@index([tenantId])
  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([tenantId, status])
  @@index([tenantId, createdById])
}

model SupportTicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  senderId   String
  message    String
  isStaff    Boolean       @default(false)
  isInternal Boolean       @default(false) // Internal staff note; never visible to regular user
  createdAt  DateTime      @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     User          @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
}

model SupportTicketAttachment {
  id          String        @id @default(uuid())
  ticketId    String
  fileName    String
  fileUrl     String
  fileSize    Int
  fileType    String
  storagePath String?
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

