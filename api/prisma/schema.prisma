model Plan {
  id                  String               @id // "free", "starter", "pro", "enterprise"
  name                String
  price               String               @default("₹0")
  priceNum            Decimal              @default(0) @db.Decimal(12, 2)
  annualPriceNum      Decimal              @default(0) @db.Decimal(12, 2)
  currency            String               @default("INR")
  billing             String               @default("per month")
  pricingMode         String               @default("FIXED") // "FIXED" | "CUSTOM"
  description         String?
  features            Json?                // Array of feature descriptions
  maxUsers            Int                  @default(3)
  maxLeads            Int                  @default(500)
  maxContacts         Int                  @default(1000)
  storageGb           Int                  @default(1)
  maxApiRequests      Int                  @default(10000)
  trialDays           Int                  @default(0)
  billingCycleMonthly Boolean              @default(true)
  billingCycleAnnual  Boolean              @default(true)
  highlight           Boolean              @default(false)
  isActive            Boolean              @default(true)
  status              String               @default("ACTIVE") // "ACTIVE", "INACTIVE", "ARCHIVED"
  sortOrder           Int                  @default(0)
  
  // AI Subscription Configuration
  aiEnabled           Boolean              @default(true)
  aiLevel             String               @default("Standard AI") // "Basic AI", "Standard AI", "Advanced AI", "Premium AI", "Full AI"
  dailyTokenLimit     Int                  @default(50000)
  defaultModelId      String?
  defaultModel        AiModel?             @relation("PlanDefaultAiModel", fields: [defaultModelId], references: [id])
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  aiEntitlements      PlanAiEntitlement[]

  @@index([status])
  @@index([sortOrder])
}

model AiModel {
  id              String              @id @default(uuid())
  modelKey        String              @unique // "gemini-1.5-flash", "gemini-2.0-flash", "gpt-4o", etc.
  displayName     String
  provider        String              @default("google") // "google", "openai", "anthropic", "xai", "mistral"
  description     String?
  contextWindow   Int                 @default(1048576)
  inputCostPer1k  Decimal             @default(0) @db.Decimal(10, 6)
  outputCostPer1k Decimal             @default(0) @db.Decimal(10, 6)
  capabilities    String[]            @default([])
  status          String              @default("ENABLED") // "ENABLED", "DISABLED", "DEPRECATED", "UNAVAILABLE"
  isChatModel     Boolean             @default(true)
  isAvailable     Boolean             @default(true)
  isDefault       Boolean             @default(false)
  isFallback      Boolean             @default(false)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

