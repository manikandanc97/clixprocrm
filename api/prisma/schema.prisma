generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model Tenant {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  plan            String           @default("free")
  status          TenantStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Workspace Settings
  taxId           String?
  address         String?
  currency        String           @default("INR")
  timezone        String           @default("utc")
  logo            String?
  brandPrimaryColor String?
  mfaPolicy       String           @default("OPTIONAL")
  securityStatus  String           @default("ACTIVE")

  // Subscription & Billing
  subscriptionStatus String        @default("ACTIVE")
  billingCycle       String        @default("monthly")
  trialStart         DateTime?
  trialEnd           DateTime?
  currentPeriodEnd   DateTime?

  // Platform Tenant Classification
  type               String        @default("CUSTOMER") // "CUSTOMER" | "PLATFORM"
  isPlatformTenant   Boolean       @default(false)

  attachments     Attachment[]
  customers       Customer[]
  departments     Department[]
  invitations     Invitation[]
  invoices        Invoice[]
  payments        Payment[]
  invoiceSettings TenantInvoiceSettings?
  platformSubscriptions PlatformSubscription[]
  platformInvoices PlatformInvoice[]
  platformPayments PlatformPayment[]
  platformRefunds  PlatformRefund[]
  leads           Lead[]
  meetings        Meeting[]
  notes           Note[]
  notifications   Notification[]
  products        Product[]
  quotations      Quotation[]
  revenueTargets  RevenueTarget[]
  roles           Role[]
  tasks           Task[]
  users           TenantUser[]
  timelineEvents  TimelineEvent[]
  aiConfig        TenantAiConfig?
  aiConversations AiConversation[]
  documents       Document[]
  companies       Company[]
  deals           Deal[]
  invoiceCounter  InvoiceCounter?
  teams           Team[]
  teamMembers     TeamMember[]
  recordShares    RecordShare[]
  supportTickets  SupportTicket[]
}

model User {
  id                 String           @id @default(uuid())
  name               String
  email              String           @unique
  phone              String?
  avatar             String?
  status             UserStatus       @default(ACTIVE)
  securityStatus     String           @default("ACTIVE")
  mustResetPassword  Boolean          @default(false)
  isSuperAdmin       Boolean          @default(false)
  notificationPrefs  Json?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  attachments        Attachment[]     @relation("AttachmentUploader")
  auditLogsTarget    AuditLog[]       @relation("AuditLogTarget")
  auditLogsActed     AuditLog[]       @relation("AuditLogActor")
  assignedCustomers  Customer[]       @relation("CustomerAssignedTo")
  assignedLeads      Lead[]           @relation("LeadAssignedTo")
  createdLeads       Lead[]           @relation("LeadCreatedBy")
  updatedLeads       Lead[]           @relation("LeadUpdatedBy")
  assignedMeetings   Meeting[]        @relation("MeetingAssignedTo")
  notes              Note[]           @relation("NoteAuthor")
  assignedQuotations Quotation[]      @relation("QuotationAssignedTo")
  assignedTasks      Task[]           @relation("TaskAssignedTo")
  createdTasks       Task[]           @relation("TaskCreatedBy")
  createdInvoices    Invoice[]        @relation("InvoiceCreatedBy")
  createdPayments    Payment[]        @relation("PaymentCreatedBy")
  memberships        TenantUser[]
  timelineEvents     TimelineEvent[]  @relation("TimelineEventActor")
  aiConversations    AiConversation[]
  ownedCompanies     Company[]
  ownedDeals         Deal[]           @relation("DealOwner")
  completedTasks     Task[]           @relation("TaskCompletedBy")
  ownedMeetings      Meeting[]        @relation("MeetingOwner")
  sessions           UserSession[]
  ledTeams           Team[]           @relation("TeamLeader")
  teamMemberships    TeamMember[]
  sharedRecords      RecordShare[]    @relation("RecordShareRecipient")
  createdShares      RecordShare[]    @relation("RecordShareCreator")
  createdSupportTickets  SupportTicket[]        @relation("TicketCreatedBy")
  assignedSupportTickets SupportTicket[]        @relation("TicketAssignedTo")
  supportTicketMessages  SupportTicketMessage[] @relation("TicketMessageSender")
}

model TenantUser {
  id                 String       @id @default(uuid())
  tenantId           String
  userId             String
  roleId             String
  departmentId       String?
  reportingManagerId String?
  branchId           String?
  isOrgOwner         Boolean      @default(false)
  status             UserStatus   @default(ACTIVE)
  joinedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  department         Department?  @relation(fields: [departmentId], references: [id])
  reportingManager   TenantUser?  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates       TenantUser[] @relation("ReportingManager")
  role               Role         @relation(fields: [roleId], references: [id])
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([departmentId])
  @@index([tenantId, isOrgOwner])
}

model Customer {
  id             String          @id @default(uuid())
  tenantId       String
  assignedToId   String?
  // AES-256-GCM encrypted PII fields
  name           String
  company        String
  email          String?
  // HMAC-SHA256 lookup hash for encrypted email (exact-match search)
  emailHash      String?
  status         CustomerStatus  @default(ACTIVE)
  revenue        Decimal         @default(0) @db.Decimal(12, 2)
  lastContactAt  DateTime?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  leadId         String?
  assignedTo     User?           @relation("CustomerAssignedTo", fields: [assignedToId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads          Lead[]          @relation("LeadCustomer")
  meetings       Meeting[]
  quotations     Quotation[]
  invoices       Invoice[]
  tasks          Task[]          @relation("TaskCustomer")
  companyId      String?
  companyRecord  Company?        @relation(fields: [companyId], references: [id])
  deals          Deal[]
  timelineEvents TimelineEvent[]
  teamId         String?
  branchId       String?

  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, deletedAt, createdAt])
  @@index([tenantId, assignedToId, deletedAt])
  @@index([assignedToId])
  @@index([tenantId, emailHash])
  @@index([tenantId, teamId])
}

model Lead {
  id                String          @id @default(uuid())
  tenantId          String
  assignedToId      String?
  // AES-256-GCM encrypted PII fields
  name              String
  company           String
  email             String
  // HMAC-SHA256 lookup hash for encrypted email (used for dedup/import exact-match)
  emailHash         String?
  value             Decimal         @default(0) @db.Decimal(12, 2)
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  phone             String?
  createdById       String?
  expectedCloseDate DateTime?
  lastActivityAt    DateTime        @default(now())
  source            String          @default("Direct")
  stage             LeadStage       @default(NEW)
  tags              String[]
  updatedById       String?
  priority          LeadPriority    @default(MEDIUM)
  isConverted       Boolean         @default(false)
  convertedAt       DateTime?
  customerId        String?
  attachments       Attachment[]
  assignedTo        User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdBy         User?           @relation("LeadCreatedBy", fields: [createdById], references: [id])
  customer          Customer?       @relation("LeadCustomer", fields: [customerId], references: [id])
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy         User?           @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  meetings          Meeting[]
  notes             Note[]
  quotations        Quotation[]
  tasks             Task[]          @relation("TaskLead")
  timelineEvents    TimelineEvent[]
  companyId         String?
  companyRecord     Company?        @relation(fields: [companyId], references: [id])
  deals             Deal[]
  teamId            String?
  branchId          String?

  @@index([tenantId, stage])
  @@index([tenantId, deletedAt])
  @@index([tenantId, stage, deletedAt])
  @@index([tenantId, deletedAt, createdAt])
  @@index([tenantId, assignedToId, deletedAt])
  @@index([assignedToId])
  @@index([customerId])
  @@index([createdAt])
  @@index([tenantId, emailHash])
  @@index([tenantId, teamId])
}

model Task {
  id                 String       @id @default(uuid())
  tenantId           String
  assignedToId       String?
  title              String
  description        String?
  dueDate            DateTime?
  priority           TaskPriority @default(MEDIUM)
  status             TaskStatus   @default(PENDING)
  visibility         EventVisibility @default(PRIVATE)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  attachments        Json?
  checklist          Json?
  completedAt        DateTime?
  createdById        String?
  relatedCustomerId  String?
  relatedLeadId      String?
  relatedMeetingId   String?
  relatedQuotationId String?
  reminderDate       DateTime?
  tags               String[]        @default([])
  progress           Int             @default(0)
  completedById      String?
  
  assignedTo         User?           @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy          User?           @relation("TaskCreatedBy", fields: [createdById], references: [id])
  completedBy        User?           @relation("TaskCompletedBy", fields: [completedById], references: [id])
  relatedCustomer    Customer?       @relation("TaskCustomer", fields: [relatedCustomerId], references: [id])
  relatedLead        Lead?           @relation("TaskLead", fields: [relatedLeadId], references: [id])
  relatedMeeting     Meeting?        @relation("TaskMeeting", fields: [relatedMeetingId], references: [id])
  relatedQuotation   Quotation?      @relation("TaskQuotation", fields: [relatedQuotationId], references: [id])
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relatedDealId      String?
  relatedDeal        Deal?           @relation("TaskDeal", fields: [relatedDealId], references: [id])
  teamId             String?
  branchId           String?
  
  timelineEvents     TimelineEvent[] @relation("TimelineTask")
  attachmentsList    Attachment[]    @relation("TaskAttachment")

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, deletedAt, dueDate])
  @@index([tenantId, assignedToId, deletedAt])
  @@index([tenantId, deletedAt, createdAt])
  @@index([tenantId, deletedAt, status, createdAt])
  @@index([assignedToId])
  @@index([createdById])
  @@index([relatedLeadId])
  @@index([relatedCustomerId])
  @@index([tenantId, teamId])
}

model Quotation {
  id           String          @id @default(uuid())
  tenantId     String
  customerId   String?
  assignedToId String?
  quoteNumber  String
  client       String
  amount       Decimal         @default(0) @db.Decimal(12, 2)
  status       QuotationStatus @default(DRAFT)
  validTill    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  discount     Decimal?        @default(0) @db.Decimal(12, 2)
  items        Json?
  leadId       String
  notes        String?
  tax          Decimal?        @default(0) @db.Decimal(12, 2)
  meetings     Meeting[]
  assignedTo   User?           @relation("QuotationAssignedTo", fields: [assignedToId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks        Task[]          @relation("TaskQuotation")
  invoices     Invoice[]
  dealId       String?
  deal         Deal?           @relation("QuotationDeal", fields: [dealId], references: [id])
  teamId       String?
  branchId     String?

  @@unique([tenantId, quoteNumber])
  @@index([customerId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([tenantId, teamId])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  userId       String?
  targetUserId String?
  action       String
  module       String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  previousHash String?
  recordHash   String?
  createdAt    DateTime @default(now())
  targetUser   User?               @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user         User?               @relation("AuditLogActor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  archiveOutbox AuditArchiveOutbox?

  @@index([userId])
  @@index([targetUserId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([createdAt])
}

model AuditArchiveOutbox {
  id            String    @id @default(uuid())
  auditLogId    String    @unique
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastAttemptAt DateTime?
  archivedAt    DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  auditLog      AuditLog  @relation(fields: [auditLogId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model SecurityAlert {
  id             String    @id @default(uuid())
  alertType      String
  severity       String    // LOW, MEDIUM, HIGH, CRITICAL
  title          String
  description    String
  userId         String?
  organizationId String?
  sourceEventId  String?
  detectedAt     DateTime  @default(now())
  status         String    @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  resolvedAt     DateTime?
  resolvedBy     String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, severity])
  @@index([organizationId])
  @@index([userId])
  @@index([detectedAt])
  @@index([alertType])
}

model SecurityIncident {
  id              String    @id @default(uuid())
  incidentNumber  String    @unique
  title           String
  description     String
  severity        String    // LOW, MEDIUM, HIGH, CRITICAL
  status          String    @default("OPEN") // OPEN, INVESTIGATING, CONTAINED, RESOLVED
  detectedAt      DateTime  @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  assignedTo      String?
  organizationId  String?
  tenantId        String?
  affectedUserId  String?
  createdBy       String
  resolutionNotes String?
  incidentType    String    @default("SECURITY_ALERT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, severity])
  @@index([tenantId])
  @@index([organizationId])
  @@index([affectedUserId])
  @@index([createdAt])
}

model PlatformSecurityState {
  id               String    @id @default("global")
  emergencyMode    Boolean   @default(false)
  reason           String?
  confirmationCode String?
  enabledAt        DateTime?
  enabledBy        String?
  disabledAt       DateTime?
  disabledBy       String?
  updatedAt        DateTime  @updatedAt
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  roleId    String
  token     String   @unique
  expiresAt DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String?
  priority    Int              @default(0)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitations Invitation[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       TenantUser[]

  @@unique([tenantId, name])
}

model Department {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       TenantUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  roleId    String
  module    String
  action    String?
  scope     DataScope @default(ORGANIZATION)
  hasAccess Boolean   @default(true)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, module])
  @@index([roleId])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  sku         String?
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Invoice {
  id                      String          @id @default(uuid())
  tenantId                String
  customerId              String?
  companyId               String?
  dealId                  String?
  quotationId             String?
  invoiceNumber           String?
  invoiceDate             DateTime        @default(now())
  dueDate                 DateTime?
  currency                String          @default("INR")
  paymentTerms            String?         @default("DUE_ON_RECEIPT")
  status                  String          @default("DRAFT") // DRAFT, SENT, VIEWED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED, VOID, REFUNDED

  // Precise monetary representation
  amount                  Decimal         @default(0) @db.Decimal(12, 2) // Legacy compatibility alias for totalAmount
  subtotal                Decimal         @default(0) @db.Decimal(12, 2)
  discountType            String?         // "PERCENTAGE" | "FIXED"
  discountValue           Decimal?        @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal         @default(0) @db.Decimal(12, 2)
  taxableAmount           Decimal         @default(0) @db.Decimal(12, 2)
  cgstAmount              Decimal         @default(0) @db.Decimal(12, 2)
  sgstAmount              Decimal         @default(0) @db.Decimal(12, 2)
  igstAmount              Decimal         @default(0) @db.Decimal(12, 2)
  otherTaxAmount          Decimal         @default(0) @db.Decimal(12, 2)
  roundOff                Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal         @default(0) @db.Decimal(12, 2)
  paidAmount              Decimal         @default(0) @db.Decimal(12, 2)
  balanceAmount           Decimal         @default(0) @db.Decimal(12, 2)

  // Details and terms
  notes                   String?
  termsAndConditions      String?
  customerBillingAddress  Json?
  orgBillingAddress       Json?
  pdfUrl                  String?

  // Audit and lifecycle timestamps
  createdById             String?
  sentAt                  DateTime?
  viewedAt                DateTime?
  paidAt                  DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  // Relations
  tenant                  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                Customer?       @relation(fields: [customerId], references: [id])
  company                 Company?        @relation(fields: [companyId], references: [id])
  deal                    Deal?           @relation("InvoiceDeal", fields: [dealId], references: [id])
  quotation               Quotation?      @relation(fields: [quotationId], references: [id])
  createdBy               User?           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items                   InvoiceItem[]
  payments                Payment[]
  timelineEvents          TimelineEvent[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([companyId])
  @@index([dealId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  productId      String?
  name           String
  description    String?
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unit           String?  @default("unit")
  unitPrice      Decimal  @default(0) @db.Decimal(12, 2)
  discountType   String?  // "PERCENTAGE" | "FIXED"
  discountValue  Decimal? @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(6, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String
  paymentNumber   String
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  currency        String   @default("INR")
  paymentMethod   String   @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, UPI, CARD, CHEQUE, OTHER
  paymentDate     DateTime @default(now())
  referenceNumber String?  // UTR / Transaction ID / Cheque #
  notes           String?
  status          String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, REFUNDED
  receiptUrl      String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, paymentNumber])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([status])
}

model TenantInvoiceSettings {
  id                 String   @id @default(uuid())
  tenantId           String   @unique
  invoicePrefix      String   @default("INV")
  nextInvoiceNumber  Int      @default(1)
  financialYear      String?  @default("2026-2027")
  gstin              String?
  pan                String?
  legalName          String?
  billingAddress     String?
  city               String?
  state              String?
  postalCode         String?
  country            String?  @default("India")
  bankName           String?
  accountNumber      String?
  ifscCode           String?
  accountHolderName  String?
  upiId              String?
  defaultNotes       String?  @default("Thank you for doing business with us.")
  defaultTerms       String?  @default("Payment is due within 15 days of invoice date.")
  taxType            String   @default("GST") // GST, VAT, NONE
  defaultTaxRate     Decimal  @default(18.0) @db.Decimal(6, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Meeting {
  id           String     @id @default(uuid())
  tenantId     String
  title        String
  startTime    DateTime
  endTime      DateTime
  // AES-256-GCM encrypted sensitive fields
  location     String?
  isOnline     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedToId String?
  description  String?
  isAllDay     Boolean    @default(false)
  status       String     @default("SCHEDULED")
  type         EventType  @default(MEETING)
  duration     Int        @default(30)
  leadId       String?
  meetingNotes String?
  participants Json?
  reminderAt   DateTime?
  customerId   String?
  quotationId  String?
  ownerId      String?
  visibility   EventVisibility @default(PRIVATE)
  cancelledAt  DateTime?
  cancellationReason String?
  
  assignedTo   User?      @relation("MeetingAssignedTo", fields: [assignedToId], references: [id])
  owner        User?      @relation("MeetingOwner", fields: [ownerId], references: [id])
  customer     Customer?  @relation(fields: [customerId], references: [id])
  lead         Lead?      @relation(fields: [leadId], references: [id])
  quotation    Quotation? @relation(fields: [quotationId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks        Task[]     @relation("TaskMeeting")
  dealId       String?
  deal         Deal?      @relation("MeetingDeal", fields: [dealId], references: [id])
